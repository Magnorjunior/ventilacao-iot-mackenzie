    {
        "id": "parse-openweather",
        "type": "function",
        "z": "tab-mackiot",
        "name": "Parse OpenWeather",
        "func": "var tempExt = msg.payload.main.temp;\nvar umidExt = msg.payload.main.humidity;\nvar vento = msg.payload.wind.speed;\nvar ceu = msg.payload.weather[0].description;\n\nglobal.set('tempExt', tempExt);\nglobal.set('umidExt', umidExt);\n\nmsg.payload = {\n    temperatura_externa: tempExt,\n    umidade_externa: umidExt,\n    vento: vento,\n    ceu: ceu\n};\n\nreturn msg;",
        "outputs": 1,
        "x": 1220,
        "y": 400,
        "wires": [
            [
                "influx-openweather",
                "debug-openweather"
            ]
        ]
