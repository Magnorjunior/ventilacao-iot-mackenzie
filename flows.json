    {
        "id": "regra-negocio",
        "type": "function",
        "z": "tab-mackiot",
        "name": "Regra de Negócio",
        "func": "var temp = global.get('temperatura') || 0;\nvar umid = global.get('umidade') || 0;\nvar ppm = global.get('ppm') || 0;\n\nvar nivel = 0;\nvar status = 'adequado';\n\nif (temp > 31 || umid > 70) {\n    nivel = 2;\n    status = 'critico';\n} else if (temp > 26 || umid > 60) {\n    nivel = 1;\n    status = 'atencao';\n}\n\nglobal.set('nivel', nivel);\nglobal.set('status', status);\n\nmsg.payload = String(nivel);\nmsg.status = status;\nmsg.temp = temp;\nmsg.umid = umid;\nmsg.ppm = ppm;\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 570,
        "y": 300,
        "wires": [
            [
                "verifica-alerta",
                "openweather-trigger",
                "mqtt-out-alerta"
            ]
        ]
    },
    {
        "id": "mqtt-out-alerta",
        "type": "mqtt out",
        "z": "tab-mackiot",
        "name": "Publica Alerta",
        "topic": "mackiot/atuador/alerta",
        "qos": "0",
        "retain": false,
        "broker": "mqtt-broker-hivemq",
        "x": 1000,
        "y": 180,
        "wires": []
    },
    {
        "id": "verifica-alerta",
        "type": "function",
        "z": "tab-mackiot",
        "name": "Verifica se envia Telegram",
        "func": "var nivel = global.get('nivel') || 0;\nif (nivel >= 1) {\n    msg.payload = {\n        chatId: 8776071430,\n        type: \"message\",\n        content: '⚠️ Alerta MacKIoT!\\n' +\n            'Status: ' + msg.status.toUpperCase() + '\\n' +\n            'Temperatura: ' + msg.temp + ' °C\\n' +\n            'Umidade: ' + msg.umid + ' %\\n' +\n            'Qualidade do ar: ' + msg.ppm + ' PPM'\n    };\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 800,
        "y": 300,
        "wires": [
